@model IEnumerable<BibliotecaDigital.Models.Borrow>
@{
    var today = DateOnly.FromDateTime(DateTime.Today);
}
<div class="row">
    <div class="col-md-9">
        <h2>Préstamos</h2>
        <table class="table table-bordered">
            <thead>
            <tr>
                <th>Id</th>
                <th>Usuario</th>
                <th>Libro</th>
                <th>Fecha Devolución</th>
                <th>Acciones</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var br in Model)
            {
                <tr>
                    <td>@br.IdBorrow</td>
                    <td>@br.user?.Name</td>
                    <td>@br.book?.Title</td>
                    <td>@br.ReturnDate</td>
                    <td>
                        @if (br.ReturnDate >= today)
                        {
                            <a class="btn btn-sm btn-outline-success" asp-action="Return" asp-route-id="@br.IdBorrow">Devolver</a>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Devuelto</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="col-md-3 sticky-top">
        <div class="card">
            <div class="card-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                
                <form asp-action="Register" method="post">
                    <div class="mt-3">
                        <label>Usuario</label>
                        <select class="form-select" name="UserId" required>
                            <option value="">-- Seleccione --</option>
                            @foreach (var u in (IEnumerable<BibliotecaDigital.Models.User>)ViewBag.Users)
                            {
                                <option value="@u.IdUser">@u.Name (@u.Document)</option>
                            }
                        </select>
                    </div>
                    <div class="mt-3">
                        <label>Libro</label>
                        <select class="form-select" name="BookId" required>
                            <option value="">-- Seleccione --</option>
                            @foreach (var b in (IEnumerable<BibliotecaDigital.Models.Book>)ViewBag.Books)
                            {
                                <option value="@b.IdBook">@b.Title (@b.Code) - Stock: @b.StockAvailable</option>
                            }
                        </select>
                    </div>
                    <div class="mt-3">
                        <label>Fecha de devolución</label>
                        <input type="date" class="form-control" name="ReturnDate" required>
                    </div>
                    <hr>
                    <button type="submit" class="btn btn-primary w-100">Registrar préstamo</button>
                </form>
                <hr>
                <h6>Consultas rápidas</h6>
                <form asp-action="HistoryByUser" method="get" class="d-flex gap-2">
                    <input type="number" class="form-control" name="userId" placeholder="Id Usuario" min="1" required>
                    <button type="submit" class="btn btn-outline-primary">Historial</button>
                </form>
                <form asp-action="CurrentByBook" method="get" class="d-flex gap-2 mt-2">
                    <input type="number" class="form-control" name="bookId" placeholder="Id Libro" min="1" required>
                    <button type="submit" class="btn btn-outline-secondary">Vigentes</button>
                </form>
                <div class="mt-3 d-grid gap-2">
                    <a class="btn btn-light" asp-controller="User" asp-action="Index">Usuarios</a>
                    <a class="btn btn-light" asp-controller="Book" asp-action="Index">Libros</a>
                </div>
            </div>
        </div>
    </div>
</div>
