@model IEnumerable<BibliotecaDigital.Models.Book>
<div class="row">
    <div class="col-md-9">
        
        <table class="table table-bordered">
            <h2>Lista de Libros</h2>
            <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Code</th>
                <th>Author</th>
                <th>Stock</th>
                <th>Edit</th>
                <th>Delete</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdBook</td>
                    <td>@item.Title</td>
                    <td>@item.Code</td>
                    <td>@item.Author?.Name</td>
                    <td>@item.StockAvailable</td>
                    <td>Edit</td>
                    <td>Delete</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="col-md-3 sticky-top">
        <div class="card">
            <div class="card-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
            
                <form asp-action="Register" method="post">
                    <div class="mt-3">
                        <label>Title</label>
                        <input type="text" class="form-control" name="Title" required>
                    </div>
                    <div class="mt-3">
                        <label>Code</label>
                        <input type="text" class="form-control" name="Code" required>
                    </div>
                    <div class="mt-3">
                        <label>Author</label>
                        <input type="text" class="form-control" name="Author.Name" required>
                    </div>
                    <div class="mt-3">
                        <label>Stock</label>
                        <input type="number" min="0" class="form-control" name="StockAvailable" required>
                    </div>
                    <hr>
                    <button type="submit" class="btn btn-primary w-100">Add Book</button>
                </form>
            </div>
        </div>
    </div>
</div>